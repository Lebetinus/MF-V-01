{
  "name": "mf-v-01",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --env-file-if-exists=.env.test --experimental-strip-types --test tests/excel-amount.test.mjs tests/rendered-html.test.mjs tests/build-assets.test.mjs tests/api.test.mjs",
    "lint": "eslint .",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "node --env-file=.env.local scripts/seed-users.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "pg": "^8.13.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vinext": "1.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
